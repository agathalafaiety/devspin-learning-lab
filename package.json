{
  "name": "devspin-learning-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevSpin — aprendizagem ativa para desenvolvimento, IA e dados.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @devspin/web",
    "build": "npm run build --workspace @devspin/web",
    "predeploy": "npm run build --workspace @devspin/web -- --base=/devspin-learning-lab/",
    "deploy": "gh-pages -d dist",
    "preview": "npm run preview --workspace @devspin/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @devspin/web",
    "test:coverage": "npm run test:coverage --workspace @devspin/web",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.5",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2"
  }
}
